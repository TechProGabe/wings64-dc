# wings64-dc toolchain pins. Change only deliberately (scripts/bump_pins.sh is not automatic).
# Resolved 2026-10-10.

# KallistiOS v2.2.2 (lightweight tag -> commit). At this rev the toolchain maker is utils/dc-chain.
KOS_URL=https://github.com/KallistiOS/KallistiOS.git
KOS_REV=c23410b3aa1ba6eeb00ac21a0634952edfaa1708

# dc-chain profile: GCC 14.3.0 / binutils 2.44 / newlib 4.5.0.20241231.
# Fallback at this KOS rev is 13.4.0 (13.2.0 no longer ships as a profile); 15.1.0 experiment only.
TOOLCHAIN_PROFILE=14.3.0

# mkdcdisc v0.0.4 (main @ 2026-09-20; upstream publishes no tag).
MKDCDISC_URL=https://gitlab.com/simulant/mkdcdisc.git
MKDCDISC_REV=2b98b0d9480e364e3517355648fbc3b49fb19882

# Decomp: fetched into external/pw64-decomp/ (gitignored) and patched from patches/.
DECOMP_URL=https://github.com/gcsmith/Pilotwings64Decomp.git
DECOMP_REV=1a8558f5ceb320cce254d6da0a49a1f2bbc23e21

# sh4zam: git submodule external/sh4zam (recorded here for the lint and for humans).
SH4ZAM_URL=https://github.com/TechProGabe/sh4zam.git
SH4ZAM_REV=7747e5d281a75dd4ffce10df2758748feb421c66

# SH-4 FP ABI for KOS, newlib multilib and every object we build.
KOS_SH4_PRECISION=-m4-single-only

IMAGE_NAME=wings64-dc
